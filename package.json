{
  "name": "pi-rich-renderer",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Display-only, sandboxed LaTeX formula images for Pi.",
  "repository": { "type": "git", "url": "git+https://github.com/catwinee/pi-rich-renderer.git" },
  "files": ["index.ts", "src", "README.md", "AUDIT.md"],
  "pi": { "extensions": ["./index.ts"] },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@earendil-works/pi-tui": "1.1.0",
    "typescript": "^5.7.3",
    "@types/node": "^24.3.0",
    "@types/pngjs": "6.0.5",
    "tsx": "^4.20.0"
  },
  "overrides": {
    "@earendil-works/pi-codemode": "1.1.0",
    "@earendil-works/pi-agent-core": "1.1.0",
    "@earendil-works/pi-ai": "1.1.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:integration": "PI_RICH_TEST_TEX=1 tsx --test test/*.test.ts",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "pngjs": "7.0.0"
  }
}
